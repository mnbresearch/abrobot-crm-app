# AbroBot CRM — every configuration value the code reads, with NO real values.
# Copy what you need; never commit a filled-in copy (.env* other than this file
# should stay out of git).
#
# ── Frontend (app/, read by Vite at build time) ───────────────────────────────
# Both are public by design: the publishable key is shipped to every browser and
# grants only what row-level security allows. They default to production in
# app/src/lib/supabase.ts, so a normal build needs neither.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# ── Edge function secrets ────────────────────────────────────────────────────
# Set in Supabase dashboard → Edge Functions → Secrets (or `supabase secrets set`).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform.
#
# Scheduler auth. Must equal app_settings.cron_secret in the database.
CRON_SECRET=<openssl rand -hex 32>

# AI assistant (chat-agent, summarize-chats)
GROQ_API_KEY=

# Platform email (nurture fallback, app-signup, checkout-recovery)
RESEND_API_KEY=
NURTURE_FROM="AbroBot <hello@your-verified-domain>"
NURTURE_REPLY_TO=
# Optional overrides for abandoned-checkout reminders; fall back to NURTURE_*.
RECOVERY_FROM=
RECOVERY_REPLY_TO=

# Payments (billing-checkout, billing-webhook)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox            # or production

# Alerts (platform default bot; tenants can bring their own)
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API platform defaults (tenants normally configure their own)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
META_GRAPH_VERSION=v21.0

# app.abrobot.ai signup bridge (app-signup)
APP_WEBHOOK_SECRET=

# Links used in emails
CRM_BASE_URL=https://crm.mnbresearch.com
BOOKING_URL=
